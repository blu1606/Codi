# Database configuration
# Dev: Supabase Postgres. Get the connection string via CLI (`pnpm supabase:login`, then
# `pnpm supabase:link -- --project-ref <ref>`) or from Dashboard → Project Settings →
# Database → Connection string → "Transaction pooler" (port 6543, not the direct 5432
# connection — Next.js dev opens many short-lived connections and will exhaust Supabase's
# direct-connection limit).
# Production (later): a self-hosted Postgres via Docker, reached through this same
# DATABASE_URL — no code change needed to switch, see docs/tech-stack.md §4.
# Only a standard `postgres://` connection string is used anywhere in the app — never
# @supabase/supabase-js or any other Supabase-specific SDK — so the database is swappable.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Optional: only needed if you run the local Postgres container instead of Supabase
# (`docker compose --profile local-db up -d`). Uncomment DATABASE_URL below to match.
# POSTGRES_HOST_PORT=5433
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/codi

# Better Auth configuration (required for authentication)
BETTER_AUTH_SECRET=your-secret-key-min-32-chars-for-production
BETTER_AUTH_URL=http://localhost:3000

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email provider selection
# Options: smtp (local development with Mailpit), resend (production)
EMAIL_PROVIDER=smtp

# SMTP configuration (required when EMAIL_PROVIDER=smtp)
SMTP_HOST=localhost
SMTP_PORT=1025

# Resend API configuration (required when EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Storage provider selection
# Options: r2 (Cloudflare R2), local (file system)
STORAGE_PROVIDER=r2

# Cloudflare R2 configuration (required when STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET=codi-assets

# OAuth providers (optional but recommended)
# Google OAuth (required for Google sign-in)
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub OAuth (required for GitHub sign-in)
GITHUB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM provider selection (for AI features). Options: gemini (default), openai.
# Each is a separate LlmProvider implementation — see apps/web/src/lib/ai/.
# Only the API key for the selected provider is required.
AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash

GOOGLE_GENERATIVE_AI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
