# Copy to backend/.env. Everything has a local default except the optional integrations.
# Never point DATABASE_URL at a hosted (Supabase) database.
DATABASE_URL=postgresql://codi:codi@localhost:5544/codi
API_PORT=4100
# Browser origin (Vite proxies /api, so auth is same-origin)
BETTER_AUTH_URL=http://localhost:3001
# At least 32 characters
BETTER_AUTH_SECRET=
# Password of every seeded demo account (default Codi@12345)
SEED_ACCOUNT_PASSWORD=

# AI (gemini default, or openai)
AI_PROVIDER=
AI_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
# AI background jobs (GitHub analysis, knowledge map, quiz generation, learning paths) run inside the API process.
# Default true. false stops the worker: GitHub analysis, quiz generation and learning paths run inline, knowledge-map
# extraction is unavailable.
AI_BACKGROUND_WORKER_ENABLED=
# Knowledge-map and quiz jobs per lecturer, type and UTC day (1-999, default 5)
AI_DAILY_JOB_LIMIT=

# Email: without a Resend key, OTP codes are printed to the backend console
RESEND_API_KEY=
EMAIL_FROM=

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare Turnstile on email sign-up (optional; both keys or neither). Local testing can use Cloudflare's
# always-pass test keys: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SePay: payment endpoints fail closed unless all three are set
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=

# Cloudflare R2 (optional; avatar, assignment and lecture media uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ASSIGNMENT_BUCKET=
R2_PUBLIC_URL=

# GitHub skill-profile analysis budget (all three, or the analysis is disabled)
GITHUB_PROFILE_BUDGET_KEY=
GITHUB_PROFILE_BUDGET_SLOT=
GITHUB_PROFILE_CANDIDATE_SHA=

# Lecture video tools (default: ffmpeg / ffprobe on the PATH)
FFMPEG_PATH=
FFPROBE_PATH=
