{
  "name": "@codi-1/db",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate:deploy": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:start": "docker compose -f ../../docker-compose.yml --profile local-db up -d postgres",
    "db:watch": "docker compose -f ../../docker-compose.yml --profile local-db up postgres",
    "db:stop": "docker compose -f ../../docker-compose.yml --profile local-db stop postgres",
    "db:down": "docker compose -f ../../docker-compose.yml --profile local-db down"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "^8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@codi-1/config": "workspace:*",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "catalog:",
    "varlock": "catalog:"
  }
}
