{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-pdf-assets.mjs && next dev --port 3001",
    "build": "node scripts/prepare-pdf-assets.mjs && next build --webpack && node scripts/restore-vercel-build-lock.mjs",
    "check-types": "tsc --noEmit",
    "test:e2e": "playwright test",
    "start": "next start --port 3001",
    "worker:ai": "varlock run -- tsx scripts/ai-worker.ts",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- pnpm dlx auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes",
    "db:seed-accounts": "tsx --env-file=.env scripts/seed-accounts.ts",
    "db:seed-onboarding": "tsx --env-file=.env scripts/seed-onboarding-dev.ts",
    "test:onboarding:db": "tsx --env-file=.env scripts/verify-onboarding.ts",
    "test:learning-path:db": "tsx --env-file=.env scripts/verify-learning-path.ts",
    "db:seed-learning-path": "tsx --env-file=.env scripts/seed-learning-path-dev.ts",
    "db:seed-knowledge-map": "tsx --env-file=.env scripts/seed-knowledge-map-dev.ts",
    "db:seed-lesson-player": "tsx --env-file=.env scripts/seed-lesson-player-dev.ts",
    "test:lesson-player:db": "tsx --env-file=.env scripts/verify-lesson-player.ts",
    "test:assessments:db": "tsx --env-file=.env scripts/verify-assessments.ts",
    "db:seed-assessments": "tsx --env-file=.env scripts/seed-assessments-dev.ts",
    "db:seed-coding": "tsx --env-file=.env scripts/seed-coding-dev.ts",
    "db:split-practice": "tsx --env-file=.env scripts/split-practice-dev.ts",
    "db:seed-mockup": "tsx --env-file=.env scripts/seed-mockup.ts",
    "demo:snapshot": "varlock run -- tsx scripts/export-demo-fixtures.ts",
    "test:coding:db": "tsx --env-file=.env scripts/verify-coding.ts",
    "test:tutorial:db": "tsx --env-file=.env scripts/verify-tutorial.ts",
    "test:assessments:r2": "tsx --env-file=.env scripts/verify-assignment-r2.ts",
    "storage:assignments:sweep": "tsx --env-file=.env scripts/sweep-assignment-files.ts"
  },
  "dependencies": {
    "@codi-1/coding-runner": "workspace:*",
    "prettier": "^3.6.2",
    "@ai-sdk/devtools": "^1.0.15",
    "@ai-sdk/google": "^4.0.64",
    "@ai-sdk/openai": "^4.0.0",
    "@ai-sdk/react": "^4.0.96",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@codi-1/auth": "workspace:*",
    "@codi-1/db": "workspace:*",
    "@codi-1/ui": "workspace:*",
    "@swc/helpers": "^0.5.23",
    "@tanstack/react-form": "^1.33.5",
    "@varlock/nextjs-integration": "1.2.2",
    "ai": "^7.0.93",
    "babel-plugin-react-compiler": "^1.0.0",
    "better-auth": "catalog:",
    "cn": "^0.2.6",
    "drizzle-orm": "catalog:",
    "framer-motion": "^13.4.0",
    "lucide-react": "catalog:",
    "next": "^16.3.4",
    "next-themes": "catalog:",
    "pdfjs-dist": "^6.4.299",
    "radix-ui": "^1.6.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "catalog:",
    "streamdown": "^2.6.0",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@codi-1/config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "^5.0.2"
  }
}
