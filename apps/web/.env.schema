# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @internal @required=false
VERCEL_ENV=

# @internal @required=false
VERCEL_URL=

# @internal @required=false
VERCEL_PROJECT_PRODUCTION_URL=

# @internal @required=false @type=url(prependHttps=true)
VERCEL_ORIGIN=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# The app's own base URL -- appears in OAuth redirect_uri params, cookie
# domains, and canonical links sent to the browser. Not a secret.
# @public @type=url
BETTER_AUTH_URL=$VERCEL_ORIGIN

# AI provider selection: gemini (default) or openai. Each provider is a
# separate LlmProvider implementation in src/lib/ai/providers/ — switching
# is an env change only, see src/lib/ai/index.ts.
# @type=enum(gemini, openai) @required=false
AI_PROVIDER=gemini

# Optional model override for the selected provider (e.g. gpt-4o, gemini-2.5-pro).
# @type=string(minLength=1) @required=false
AI_MODEL=

# @type=string(minLength=1) @required=false
GOOGLE_GENERATIVE_AI_API_KEY=

# @type=string(minLength=1) @required=false
OPENAI_API_KEY=

# @type=string(minLength=1)
DATABASE_URL=

# @type=string(minLength=1) @required=false
RESEND_API_KEY=

# OAuth client id is a public identifier by design (it appears in every
# browser redirect to Google) -- not a secret like GOOGLE_CLIENT_SECRET.
# @public @type=string(minLength=1) @required=false
GOOGLE_CLIENT_ID=

# @type=string(minLength=1) @required=false
GOOGLE_CLIENT_SECRET=

# @type=string(minLength=1) @required=false
EMAIL_FROM=

# @type=string(minLength=1) @required=false
R2_ACCOUNT_ID=

# @type=string(minLength=1) @required=false
R2_ACCESS_KEY_ID=

# @type=string(minLength=1) @required=false
R2_SECRET_ACCESS_KEY=

# @type=string(minLength=1) @required=false
R2_BUCKET=

# The public CDN base for avatar images -- embedded directly in every
# profile/avatar response as part of the image URL. Not a secret.
# @public @type=string(minLength=1) @required=false
R2_PUBLIC_URL=
