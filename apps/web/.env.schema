# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @internal @required=false
VERCEL_ENV=

# @internal @required=false
VERCEL_URL=

# @internal @required=false
VERCEL_PROJECT_PRODUCTION_URL=

# @internal @required=false @type=url(prependHttps=true)
VERCEL_ORIGIN=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# The app's own base URL -- appears in OAuth redirect_uri params, cookie
# domains, and canonical links sent to the browser. Not a secret.
# @public @type=url
BETTER_AUTH_URL=$VERCEL_ORIGIN

# @required=false @type=boolean
AI_BACKGROUND_WORKER_ENABLED=false

# @required=false
AI_DAILY_JOB_LIMIT=5

# AI provider selection: gemini (default) or openai. Each provider is a
# separate LlmProvider implementation in src/lib/ai/providers/ — switching
# is an env change only, see src/lib/ai/index.ts.
# @public @type=enum(gemini, openai) @required=false
AI_PROVIDER=gemini

# Optional model override for the selected provider (e.g. gpt-4o, gemini-2.5-pro).
# @public @type=string(minLength=1) @required=false
AI_MODEL=

# @type=string(minLength=1) @required=false
GOOGLE_GENERATIVE_AI_API_KEY=

# @type=string(minLength=1) @required=false
OPENAI_API_KEY=

# @type=string(minLength=1)
DATABASE_URL=

# @type=string(minLength=1) @required=false
RESEND_API_KEY=

# OAuth client id is a public identifier by design (it appears in every
# browser redirect to Google) -- not a secret like GOOGLE_CLIENT_SECRET.
# @public @type=string(minLength=1) @required=false
GOOGLE_CLIENT_ID=

# @type=string(minLength=1) @required=false
GOOGLE_CLIENT_SECRET=

# @public @type=string(minLength=1) @required=false
GITHUB_CLIENT_ID=

# @type=string(minLength=1) @required=false
GITHUB_CLIENT_SECRET=

# @type=string(minLength=1) @required=false
EMAIL_FROM=

# Account ID, access key ID and assignment bucket are part of every presigned URL
# (host and X-Amz-Credential), so they are not secrets. R2_SECRET_ACCESS_KEY stays sensitive.
# @type=string(minLength=1) @required=false @sensitive=false
R2_ACCOUNT_ID=

# @type=string(minLength=1) @required=false @sensitive=false
R2_ACCESS_KEY_ID=

# @type=string(minLength=1) @required=false
R2_SECRET_ACCESS_KEY=

# @type=string(minLength=1) @required=false
R2_BUCKET=

# Private R2 bucket for learner assignment files. Public access must be disabled.
# Keep separate from the public avatar bucket.
# @type=string(minLength=1) @required=false @sensitive=false
R2_ASSIGNMENT_BUCKET=

# The public CDN base for avatar images -- embedded directly in every
# profile/avatar response as part of the image URL. Not a secret.
# @public @type=string(minLength=1) @required=false
R2_PUBLIC_URL=

# Payment endpoints fail closed unless all three values are configured.
# @type=string(minLength=1) @required=false
SEPAY_WEBHOOK_SECRET=
# VietQR bank code, for example MB or VCB. Must match the receiving account's bank.
# Public for payment checkout screen to display VietQR transfer info.
# @public @type=string(minLength=1) @required=false
SEPAY_BANK_CODE=
# Public bank receiving account number for VietQR payments.
# @public @type=string(minLength=1) @required=false
SEPAY_ACCOUNT_NUMBER=

# E2E Test Bot credentials
# Test account emails are rendered on that account's own pages, so they are not secrets.
# @type=string(minLength=1) @required=false @sensitive=false
E2E_TEST_EMAIL=
# @type=string(minLength=1) @required=false
E2E_TEST_PASSWORD=
# @type=string(minLength=1) @required=false @sensitive=false
TEST_USER_EMAIL=
# @type=string(minLength=1) @required=false
TEST_USER_PASSWORD=

# Seed script only (pnpm db:seed-accounts): "base@mail:Name,other@mail:Name"
# @type=string(minLength=1) @required=false
SEED_ACCOUNT_TARGETS=
# @type=string(minLength=1) @required=false
SEED_ACCOUNT_PASSWORD=


# Prototype/demo only: when a read (GET /api, page loader) fails, show bundled demo data
# from src/demo-fixtures instead of the error state; only a small owner-only dot (bottom-right) marks it. Writes never fall back.
# @public @required=false @type=boolean
NEXT_PUBLIC_DEMO_FALLBACK=false

# GitHub skill-profile analysis budget (app/api/github-profile). All three must be set, or the
# analysis replies "chưa được bật". Each budget key may reserve at most 5 USD of model cost.
# Values are format-checked by the route at runtime (it fails closed); CI builds see blanked secrets.
# @type=string @required=false
GITHUB_PROFILE_BUDGET_KEY=
# pre-integration | diagnostic-preintegration | integrated | test-<slug>
# @type=string @required=false @sensitive=false
GITHUB_PROFILE_BUDGET_SLOT=
# 40-character commit SHA of the running build
# @type=string @required=false @sensitive=false
GITHUB_PROFILE_CANDIDATE_SHA=
