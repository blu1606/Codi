# Copy to deploy/monitoring/.env (git-ignored) and fill in. On the VPS it lives at /opt/monitoring/.env (mode 600).

# Grafana Cloud > your stack > Prometheus "Details": remote write endpoint and username (a number)
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
# Grafana Cloud > your stack > Loki "Details": URL + /loki/api/v1/push, and username (a number)
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
# Access policy token with scopes metrics:write and logs:write (used by Alloy only)
GRAFANA_CLOUD_TOKEN=

# Grafana stack URL and a service account token (role Admin) to provision dashboards, alert rules and Discord
GRAFANA_STACK_URL=
GRAFANA_SA_TOKEN=

# Discord channel webhook for alerts and backup failures
DISCORD_WEBHOOK_URL=

# Cloudflare R2 for database backups: reuses the app's R2 credentials from /opt/codi-rebuild/rebuild.env and its
# private assignment bucket (R2_ASSIGNMENT_BUCKET). Never the avatar bucket: /api/avatar serves any key in it.
# Names are rclone's, so backup-offsite.sh passes them straight through.
R2_BACKUP_BUCKET=
R2_BACKUP_PREFIX=db-backups/postgres
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
# The R2 S3 endpoint, https://<account-id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ENDPOINT=
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true

# Generated on the server when the codi_monitor role was created; leave empty here.
PG_MONITOR_PASSWORD=
